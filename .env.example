# Google Gemini — LLM explanation layer
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=input your key here  --- IGNORE ---

# Google Maps — Distance Matrix API (farm → buyer driving distance)
# https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=input your key here  --- IGNORE ---

# FRED — diesel prices + T-bill rate
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=input your key here  --- IGNORE ---

# NOAA CDO — historical weather observations (optional; unauthenticated is rate-limited)
# https://www.ncdc.noaa.gov/cdo-web/token
NOAA_CDO_TOKEN=input your token here  --- IGNORE ---

# USDA Market News API — cash bid data
# https://marsapi.ams.usda.gov
USDA_API_KEY=input your key here  --- IGNORE ---

# NWS point forecast API — no key required (unauthenticated)
# yfinance (CBOT futures) — no key required